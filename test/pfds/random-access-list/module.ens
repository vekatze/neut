{
  target {
    random-access-list {
      main "random-access-list.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    random-access-list-wasm {
      main "random-access-list.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
  },
}
