{
  target {
    splay-heap {
      main "splay-heap.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    splay-heap-wasm {
      main "splay-heap.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  dependency {
    core {
      digest "y_tXrgTua-N3029uEirZRTdGbOVWnwcO8IjX7QqiW1U",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
  },
}
