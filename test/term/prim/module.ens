{
  target {
    prim {
      main "prim.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    prim-wasm {
      main "prim.nt",
      platform "wasm32",
      execute ["wasmtime", "{{executable}}"],
    },
  },
  dependency {
    core {
      digest "hkhl9Bpp4lGL1MSTnhFmCGYbL9gG5Gg41VZ5LSNcd_o",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.6.tar.zst",
      ],
      enable-preset true,
    },
  },
}
