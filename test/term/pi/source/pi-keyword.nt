import {
  core::debug {assert},
  core::null {null},
}

define foo(
  foo: bool,
  a: type,
  🌟🌟🌟: type,
  竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね: int,
) -> type {
  let _ = 竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね;
  if foo {
    unpack-type a = a;
    unpack-type 🌟🌟🌟 = 🌟🌟🌟;
    pack-type {(a) -> 🌟🌟🌟}
  } else {
    unpack-type 🌟🌟🌟 = 🌟🌟🌟;
    pack-type {(🌟🌟🌟) -> type}
  }
}

define bar<a>(some-value: a) -> unit {
  let _ = some-value;
  Unit
}

define test-syntax() -> unit {
  let _ =
    foo{
      a := pack-type {int},
      foo := True,
      🌟🌟🌟 := pack-type {list(null)},
      竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね := {
        let x = 10;
        let y = 20;
        add-int(x, y)
      },
    };
  let _ =
    foo{
      a := pack-type {int},
      🌟🌟🌟 := pack-type {list(null)},
      foo := False,
      竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね := {
        let x = 10;
        let y = 20;
        add-int(x, y)
      },
    };
  let _ =
    foo{
      🌟🌟🌟 := pack-type {list(null)},
      a := {
        foo{
          竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね := {
            let x = 10;
            let y = 20;
            add-int(x, y)
          },
          a := pack-type {int},
          🌟🌟🌟 := pack-type {list(null)},
          foo := True,
        }
      },
      foo := False,
      竹の葉に霰ふるなりさらさらに独りは寝べき心地こそせね := {
        let x = 10;
        let y = 20;
        add-int(x, y)
      },
    };
  let _ =
    // hole-notation + keyword arguments
    bar{
      some-value := pack-type {type},
    };
  Unit
}

define def-func-using-of(
  arg-1: int,
  arg-2: type,
) -> type {
  let _ = arg-1;
  arg-2
}

define test-function() -> unit {
  let plain =
    function (x: int) -> int {
      add-int(x, 1)
    };
  assert("a function with a full signature", eq-int(plain(1), 2));
  let generic =
    function <a>(x: a) -> a {
      x
    };
  assert("a function with an implicit parameter", eq-int(generic(1), 1));
  let with-default =
    function (x: int)[step: int := 2] -> int {
      add-int(x, step)
    };
  assert("a function with a default argument", eq-int(with-default(1), 3));
  define increment(x: int) -> int {
    add-int(x, 100)
  };
  let labeled =
    function increment(x: int) -> int {
      increment(x)
    };
  assert("the name of a function is not bound in its body", eq-int(labeled(1), 101))
}

define test-local-keywords() -> unit {
  define sub(x: int, y: int) -> int {
    sub-int(x, y)
  };
  assert("a local definition takes key arguments", eq-int(sub{y := 3, x := 10}, 7));
  define count(i: int, total: int, step: int) -> int {
    if ge-int(i, 10) {
      total
    } else {
      count{step, total := add-int(total, i), i := add-int(i, step)}
    }
  };
  assert("the name is used twice without `!`", eq-int(count{i := 0, total := 0, step := 2}, 20));
  assert("the same definition, keys in another order", eq-int(count{step := 3, i := 1, total := 100}, 112));
  define bump(x: int)[step: int := 1] -> int {
    add-int(x, step)
  };
  assert("a default argument is filled", eq-int(bump{x := 5}, 6));
  assert("a default argument is given by key", eq-int(bump{x := 5, step := 10}, 15));
  define sub(a: int, b: int) -> int {
    mul-int(a, b)
  };
  assert("a shadowing definition has its own keys", eq-int(sub{a := 6, b := 7}, 42));
  inline twice(x: int) -> int {
    mul-int(x, 2)
  };
  assert("an inline definition takes key arguments", eq-int(twice{x := twice{x := 4}}, 16));
  let step = 1;
  define walk(x: int, limit: int) -> int {
    if ge-int(x, limit) {
      x
    } else {
      walk{x := add-int(x, step), limit}
    }
  };
  assert("a captured variable is used by a local definition", eq-int(walk{limit := 3, x := 0}, 3))
}
