import {
  core::debug {assert},
  core::rc {rc},
  this::pi-keyword,
  this::pi-term,
}

define test-syntax() -> unit {
  // nullary
  let _ = pack-type {() -> type};
  // general, non-dependent
  let _ = pack-type {(type) -> type};
  let _ = pack-type {(() -> type) -> type};
  let _ = pack-type {(() -> (type) -> type) -> type};
  let _ = pack-type {(((type) -> type) -> type) -> type};
  // general, dependent
  let _ = pack-type {(a: type, a) -> a};
  let _ = pack-type {(a: type, a) -> a};
  let _ = pack-type {(a: type, a) -> list(type)};
  let _ = pack-type {(a: type, list(type)) -> a};
  let _ = pack-type {(a: type, a) -> &list(type)};
  let _ = pack-type {(a: type, &list(type)) -> a};
  let _ = pack-type {(a: type, a) -> rc(list(type))};
  let _ = pack-type {(a: type, rc(list(type))) -> a};
  let _ = pack-type {(a: type, a) -> type};
  let _ = pack-type {(a: type, (a) -> a) -> type};
  let _ = pack-type {(a: type, ((a) -> a) -> a) -> type};
  // simplified
  let _ = pack-type {(type) -> type};
  let _ = pack-type {({(type) -> type}) -> type};
  let _ = pack-type {(type) -> (type) -> list(type)};
  let _ = pack-type {(type) -> {(type) -> type}};
  let _ = pack-type {(type) -> {(type) -> list(type)}};
  let _ = pack-type {(type) -> {(list(type)) -> type}};
  let _ = pack-type {(type) -> {(type) -> &list(type)}};
  let _ = pack-type {(type) -> {(&list(type)) -> type}};
  let _ = pack-type {(type) -> {(type) -> rc(list(type))}};
  let _ = pack-type {(type) -> {(rc(list(type))) -> type}};
  let _ = pack-type {(type) -> {({(type) -> type}) -> type}};
  let _ = pack-type {(type) -> {(type) -> {(type) -> type}}};
  let _ = pack-type {(type) -> {({(type) -> type}) -> {(type) -> type}}};
  let _ = pack-type {({(type) -> type}) -> {({(type) -> type}) -> {(type) -> type}}};
  let _ = pack-type {({({(type) -> type}) -> {(type) -> type}}) -> {({(type) -> type}) -> {(type) -> type}}};
  // complex
  let _ = pack-type {(a: type, m: (type, type) -> type) -> ({(s: type) -> (a) -> m(s, a)}) -> a};
  Unit
}

define affine-pi() -> type {
  let _ = pack-type {(type) -> type};
  pack-type {type}
}

define linear-pi() -> type {
  let x = pack-type {(type) -> type};
  x
}

define relevant-pi() -> type {
  let x = pack-type {(type) -> type};
  let _ = x;
  x
}

define test-resource() -> unit {
  let _ = affine-pi();
  let _ = linear-pi();
  let _ = relevant-pi();
  Unit
}

data functor(f: (type) -> type) {
| Functor(map: <a, b>((a) -> b, f(a)) -> f(b))
}

define list-map<a, b>(!f: (a) -> b, xs: list(a)) -> list(b) {
  match xs {
  | Nil =>
    Nil
  | Cons(y, ys) =>
    Cons(f(y), list-map(f, ys))
  }
}

define increment-all<f: (type) -> type>(fu: functor(f), xs: f(int)) -> f(int) {
  let Functor(map) = fu;
  map((x) => {add-int(x, 1)}, xs)
}

define select<f: (type) -> type>(xs: f(int)) -> f(int) {
  xs
}

define test-higher-kinded() -> unit {
  pin ys = increment-all(Functor(list-map), List::[1, 2, 3]);
  assert("a functor over list", eq-int(core::list::length(ys), 3));
  pin zs = increment-all<list>(Functor(list-map), List::[1]);
  assert("a functor over list, explicitly", eq-int(core::list::length(zs), 1));
  pin ws = select<list>(List::[1, 2]);
  assert("an explicit type constructor", eq-int(core::list::length(ws), 2));
}

define main() -> unit {
  test-higher-kinded();
  test-syntax();
  test-resource();
  this::pi-term::test-syntax();
  this::pi-term::test-resource();
  this::pi-keyword::test-syntax()
}
