import {
  core::debug {assert},
}

data nat {
| Zero
| Succ(nat)
}

data empty {}

define affine-nat() -> unit {
  let _ = Zero;
  let _ = Succ(Zero);
  let _ = Succ(Succ(Zero));
  Unit
}

define relevant-nat() -> unit {
  let !zero = Zero;
  let !one = Succ(Zero);
  let !two = Succ(Succ(Zero));
  let _ = zero;
  let _ = zero;
  let _ = one;
  let _ = one;
  let _ = two;
  let _ = two;
  Unit
}

define affine-list() -> unit {
  let _: list(nat) = List::[];
  let _ = List::[Zero];
  let _ = List::[Succ(Zero), Zero];
  Unit
}

define relevant-list() -> unit {
  let !zero: list(nat) = List::[];
  let !one = List::[Zero];
  let !two = List::[Succ(Zero), Zero];
  let _ = zero;
  let _ = zero;
  let _ = one;
  let _ = one;
  let _ = two;
  let _ = two;
  Unit
}

define affine-either() -> unit {
  let _: either(bool, list(nat)) = Left(True);
  let _: either(bool, list(nat)) = Right(List::[Zero]);
  let _: either(bool, list(nat)) = Right(List::[Succ(Zero), Zero]);
  Unit
}

define relevant-either() -> unit {
  let !foo: either(bool, list(nat)) = Left(True);
  let !bar: either(bool, list(nat)) = Right(List::[Zero]);
  let !buz: either(bool, list(nat)) = Right(List::[Succ(Zero), Zero]);
  let _ = foo;
  let _ = foo;
  let _ = bar;
  let _ = bar;
  let _ = buz;
  let _ = buz;
  Unit
}

data term(a) {
| Var(a)
| Abs(a, term(a))
| App(term(a), term(a))
}

define local-completeness<a>(t: term(a)) -> term(a) {
  match t {
  | Var(v) =>
    Var(v)
  | Abs(x, t1) =>
    Abs(x, t1)
  | App(t1, t2) =>
    App(t1, t2)
  }
}

define nested-match<a>(t: term(a)) -> term(a) {
  match t {
  | App(Abs(_, t), _) =>
    t
  | t =>
    t
  }
}

data my-enum {
| Foo
| Bar
}

define either-bind<a, b>(x: either(unit, a), f: (a) -> either(unit, b)) -> either(unit, b) {
  match x {
  | Left(_) =>
    Left(Unit)
  | Right(value) =>
    f(value)
  }
}

define unit-bind(x: unit, f: (unit) -> unit) -> unit {
  let _ = x;
  f(Unit)
}

define using-if() -> int {
  let _ =
    if True {
      if False {
        Unit
      } else {
        Unit
      }
    } else {
      Unit
    };
  let some-cond = True;
  when some-cond {
    print("hey")
  };
  if False {
    1
  } else-if lt-int(0, 10) {
    2
  } else {
    3
  }
}

define with-bind-through-if(cond: bool) -> either(unit, int) {
  with either-bind {
    if cond {
      bind x = Right(10);
      Right(add-int(x, 1))
    } else-if False {
      bind x = Right(20);
      Right(add-int(x, 2))
    } else {
      bind x = Right(30);
      Right(add-int(x, 3))
    }
  }
}

define with-bind-through-when(cond: bool) -> unit {
  with unit-bind {
    when cond {
      bind _ = Unit;
      Unit
    }
  }
}

define with-bind-through-match(xs: list(int)) -> either(unit, int) {
  with either-bind {
    match xs {
    | Nil =>
      bind x = Right(0);
      Right(x)
    | Cons(x, _) =>
      bind y = Right(x);
      Right(add-int(y, 1))
    }
  }
}

define with-bind-through-case(xs: &list(int)) -> either(unit, int) {
  with either-bind {
    case xs {
    | Nil =>
      bind x = Right(0);
      Right(x)
    | Cons(x, _) =>
      bind y = Right(*x);
      Right(add-int(y, 1))
    }
  }
}

define with-bind-through-brace(cond: bool) -> either(unit, int) {
  with either-bind {
    {
      bind x =
        if cond {
          Right(10)
        } else {
          Left(Unit)
        };
      {
        bind y = Right(20);
        Right(add-int(x, y))
      }
    }
  }
}

define test-with-bind-through-brace() -> unit {
  assert(
    "with-bind through a brace",
    match with-bind-through-brace(True) {
    | Left(_) =>
      False
    | Right(v) =>
      eq-int(v, 30)
    },
  );
  assert(
    "with-bind through a brace (short circuit)",
    match with-bind-through-brace(False) {
    | Left(_) =>
      True
    | Right(_) =>
      False
    },
  )
}

define nested-enum-match(t: term(my-enum)) -> my-enum {
  let val =
    match t {
    | App(Abs(x, !t), Var(e)) =>
      let _ = Var(e);
      let _ = t;
      let _ = x;
      let _ = Var(e);
      let _ = t;
      let _ = x;
      let _ = Var(e);
      let _ = t;
      let _ = x;
      let _ = Var(e);
      let _ = x;
      let _ = Var(e);
      let _ = x;
      x
    | App(Abs(x, _), App(Var(_), App(_, App(_, _)))) =>
      let _ = x;
      x
    | App(Abs(x, _), App(App(_, App(_, _)), Var(_))) =>
      x
    | App(App(Abs(_, _), Var(_)), App(App(Abs(y, _), App(_, _)), Var(_))) =>
      y
    | App(App(Abs(x, _), Var(_)), App(App(_, App(_, _)), Var(_))) =>
      x
    | !t =>
      let _ = t;
      let _ = t;
      let _ = t;
      Foo
    };
  match val {
  | Foo =>
    let _ = val;
    Bar
  | Bar =>
    Foo
  }
}

define unbalanced-freevars-in-branches<a>(!t: term(a)) -> term(a) {
  let !foo = Var("test");
  let f =
    () => {
      foo
    };
  let g =
    () => {
      foo
    };
  let h =
    () => {
      foo
    };
  match t {
  | Var(x) =>
    let _ = f;
    match t {
    | Var(y) =>
      let _ = g;
      let _ = x;
      Var(y)
    | Abs(_, t) =>
      t
    | _ =>
      t
    }
  | Abs(_, !t) =>
    match t {
    | App(_, e2) =>
      e2
    | _ =>
      let _ = t;
      let _ = t;
      t
    }
  | App(t1, _) =>
    let _ = g;
    let !k: () -> term(&string) =
      if False {
        h
      } else {
        () => {
          Var("pohe")
        }
      };
    let _ = k;
    let _ = k;
    let _ = k;
    t1
  }
}

define literal-match(x: int) -> int {
  match x {
  | 1 =>
    10
  | 2 =>
    20
  | 3 =>
    30
  | n =>
    add-int(n, 1)
  }
}

define literal-match-in-cons(xs: list(int)) -> int {
  match xs {
  | Nil =>
    0
  | Cons(1, _) =>
    10
  | Cons(2, _) =>
    20
  | Cons(_, _) =>
    333
  | Cons(4, _) =>
    40
  }
}

define literal-match-N(x: &int) -> int {
  case x {
  | 1 =>
    10
  | 2 =>
    20
  | 3 =>
    30
  | n =>
    add-int(*n, 1)
  }
}

define literal-match-narrow(x: int8) -> int {
  match x {
  | -128 =>
    1
  | 127 =>
    2
  | -1 =>
    3
  | _ =>
    4
  }
}

define literal-match-narrow-folded() -> int {
  let v: int8 = -128;
  match v {
  | -128 =>
    1
  | _ =>
    2
  }
}

define literal-match-unsigned-form(x: int8) -> int {
  match x {
  | 255 =>
    1
  | _ =>
    2
  }
}

define literal-match-narrow-N(x: &int8) -> int {
  case x {
  | -128 =>
    1
  | _ =>
    2
  }
}

define literal-match-first-wins(x: int) -> int {
  match x {
  | 1 =>
    10
  | 1 =>
    20
  | -1 =>
    30
  | 0xFFFFFFFFFFFFFFFF =>
    40
  | _ =>
    50
  }
}

define keyword-term-in-condition(b: bool, x: int) -> int {
  let n =
    if magic cast(bool, bool, b) {
      1
    } else-if
      match x {
      | 0 =>
        True
      | _ =>
        False
      }
    {
      2
    } else {
      3
    };
  when unquote {quote {b}} {
    Unit
  };
  let m =
    match magic cast(int, int, x) {
    | 0 =>
      10
    | _ =>
      20
    };
  let k on x = {
    case magic cast(&int, &int, x) {
    | 0 =>
      100
    | _ =>
      200
    }
  };
  let _ = x;
  add-int(n, add-int(m, k))
}

define test-keyword-term-in-condition() -> unit {
  assert("if magic", eq-int(keyword-term-in-condition(True, 0), 111));
  assert("else-if match", eq-int(keyword-term-in-condition(False, 0), 112));
  assert("else", eq-int(keyword-term-in-condition(False, 5), 223));
}

define test-literal-match-width() -> unit {
  let min8: int8 = -128;
  let max8: int8 = 127;
  let neg8: int8 = -1;
  let zero8: int8 = 0;
  assert("int8: -128", eq-int(literal-match-narrow(min8), 1));
  assert("int8: 127", eq-int(literal-match-narrow(max8), 2));
  assert("int8: -1", eq-int(literal-match-narrow(neg8), 3));
  assert("int8: 0", eq-int(literal-match-narrow(zero8), 4));
  assert("int8: -128 folded at compile time", eq-int(literal-match-narrow-folded(), 1));
  assert("int8: 255 and -1 are the same pattern", eq-int(literal-match-unsigned-form(neg8), 1));
  let r on min8 = literal-match-narrow-N(min8);
  let _ = min8;
  assert("&int8: -128", eq-int(r, 1));
  assert("first clause wins", eq-int(literal-match-first-wins(1), 10));
  assert("-1 and its unsigned form are the same label", eq-int(literal-match-first-wins(-1), 30));
  assert("fallback", eq-int(literal-match-first-wins(2), 50));
}

define literal-match-in-cons-N(xs: &list(int)) -> int {
  case xs {
  | Nil =>
    0
  | Cons(1, _) =>
    10
  | Cons(2, _) =>
    20
  | Cons(k, _) =>
    *k
  | Cons(4, _) =>
    40
  }
}

data monoid(a) {
| Monoid(
    m-empty: a,
    m-op: (a, a) -> a,
  )
}

define list-monoid<a>() -> monoid(list(a)) {
  Monoid{
    m-op := {
      (xs, ys) => {
        core::list::append(xs, ys)
      }
    },
    m-empty := Nil,
  }
}

define use-struct<a>(m: monoid(a)) -> a {
  let Monoid{m-empty := !empty, m-op} = m;
  m-op(empty, empty)
}

define use-struct-2<a>(m: monoid(a)) -> a {
  let Monoid{m-empty, m-op} = m;
  let !empty = m-empty;
  m-op(empty, empty)
}

define test-resource() -> unit {
  affine-nat();
  relevant-nat();
  affine-list();
  relevant-list();
  affine-either();
  relevant-either()
}

define test-match() -> unit {
  let !t1: term(&string) = Var("text");
  let !t2: term(&string) = Abs("foo", Var("foo"));
  let !t3: term(&string) = App(Abs("foo", Var("foo")), Var("buz"));
  let _ = local-completeness(t1);
  let _ = local-completeness(t2);
  let _ = local-completeness(t3);
  let _ = nested-match(t1);
  let _ = nested-match(t2);
  let _ = nested-match(t3);
  let !t1 = Var(Foo);
  let !t2 = Abs(Bar, Var(Bar));
  let !t3 = App(Abs(Bar, Var(Bar)), Var(Foo));
  let !t4 = Abs(Bar, App(Var(Bar), Var(Bar)));
  let _ = nested-enum-match(t1);
  let _ = nested-enum-match(t2);
  let _ = nested-enum-match(t3);
  let _ = nested-enum-match(t4);
  let _ = unbalanced-freevars-in-branches(t1);
  let _ = unbalanced-freevars-in-branches(t2);
  let _ = unbalanced-freevars-in-branches(t3);
  let _ = unbalanced-freevars-in-branches(t4);
  let n: int = 10;
  let !xs: list(int) = List::[1, 2, 3];
  let _ = literal-match(n);
  let _ on n = literal-match-N(n);
  let _ = literal-match-in-cons(xs);
  let _ on !xs = literal-match-in-cons-N(xs);
  test-literal-match-width();
  test-keyword-term-in-condition();
  let _ = with-bind-through-if(True);
  with-bind-through-when(True);
  let _ = with-bind-through-match(xs);
  let _ on xs = with-bind-through-case(xs);
  test-with-bind-through-brace();
  let _ = n;
  let _ = xs;
  let _: list(int) = use-struct(list-monoid());
  let _: list(bool) = use-struct(list-monoid());
  let _: list(() -> int) = use-struct(list-monoid());
  let _: list(int) = use-struct-2(list-monoid());
  let _: list(bool) = use-struct-2(list-monoid());
  let _: list(() -> int) = use-struct-2(list-monoid());
  Unit
}

data point {
| Point(x: int, y: int)
}

define test-syntax() -> unit {
  let p1 = Point{x := 1, y := 2};
  let p2 = Point{x := 42, .. := p1};
  let p3 = Point{.. := p2};
  let _ = Point{x := 3, y := 4, .. := p3};
  Unit
}

define main() -> unit {
  test-syntax();
  test-resource();
  test-match()
}
