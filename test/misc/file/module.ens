{
  target {
    file {
      main "file.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    file-wasm {
      main "file.nt",
      platform "wasm32",
      execute "wasmtime --dir=. {{executable}}",
    },
  },
  dependency {
    core {
      digest "fBLjigwWrBHLIDfDuIp73l0xLEnF9gCrf-cVnf0VOZU",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.10.tar.zst",
      ],
      enable-preset true,
    },
  },
}
