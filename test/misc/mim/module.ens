{
  target {
    mim {
      main "mim.nt",
      allocator "mimalloc",
    },
    mim-wasm {
      main "mim.nt",
      platform "wasm32",
      allocator "mimalloc",
      execute "wasmtime {{executable}}",
    },
    mim-sys {
      main "mim.nt",
      allocator "system",
    },
  },
  dependency {
    core {
      digest "y_tXrgTua-N3029uEirZRTdGbOVWnwcO8IjX7QqiW1U",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.9.tar.zst",
      ],
      enable-preset true,
    },
  },
}
