      digest "v5ZueFMAkJl9q3gU5dHupMJr5Wb30PHzmcDgL8_padI",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.56.1.tar.zst",
      ],
      enable-preset true,
    },
  },
}
