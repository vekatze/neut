{
  target {
    mim {
      main "mim.nt",
      allocator "mimalloc",
    },
    mim-wasm {
      main "mim.nt",
      platform "wasm32",
      allocator "mimalloc",
      execute "wasmtime {{executable}}",
    },
    mim-sys {
      main "mim.nt",
      allocator "system",
    },
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
  },
}
