{
  target {
    mim {
      main "mim.nt",
      allocator "mimalloc",
    },
    mim-wasm {
      main "mim.nt",
      platform "wasm32",
      allocator "mimalloc",
      execute "wasmtime {{executable}}",
    },
    mim-sys {
      main "mim.nt",
      allocator "system",
    },
  },
  dependency {
    core {
      digest "fBLjigwWrBHLIDfDuIp73l0xLEnF9gCrf-cVnf0VOZU",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.10.tar.zst",
      ],
      enable-preset true,
    },
  },
}
