{
  target {
    mim {
      main "mim.nt",
      allocator "mimalloc",
    },
    mim-wasm {
      main "mim.nt",
      platform "wasm32",
      allocator "mimalloc",
      execute "wasmtime {{executable}}",
    },
    mim-sys {
      main "mim.nt",
      allocator "system",
    },
  },
  dependency {
    core {
      digest "-hD_dy56xnr7w2oe-S8ZduK0_ccKID6Y0wuvi_VfqKQ",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.11.tar.zst",
      ],
      enable-preset true,
    },
  },
}
