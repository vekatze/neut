{
  target {
    mim {
      main "mim.nt",
      allocator "mimalloc",
    },
    mim-wasm {
      main "mim.nt",
      platform "wasm32",
      allocator "mimalloc",
      execute ["wasmtime", "{{executable}}"],
    },
    mim-sys {
      main "mim.nt",
      allocator "system",
    },
  },
  dependency {
    core {
      digest "RmCY7wlMkLbs2bhVARt1nvc9FF64VHb9voHD9VY0nJw",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.0.tar.zst",
      ],
      enable-preset true,
    },
  },
}
