{
  target {
    lambda-list-noetic {
      main "lambda-list-noetic.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    lambda-list-noetic-wasm {
      main "lambda-list-noetic.nt",
      platform "wasm32",
      execute ["wasmtime", "{{executable}}"],
    },
  },
  dependency {
    core {
      digest "omFUCg3IWmnhRL9j5r2LFNT8qz4Ous3jSSziDwHw3tE",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.4.tar.zst",
      ],
      enable-preset true,
    },
  },
}
