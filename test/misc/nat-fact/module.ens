{
  target {
    nat-fact {
      main "nat-fact.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    nat-fact-wasm {
      main "nat-fact.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  dependency {
    core {
      digest "-hD_dy56xnr7w2oe-S8ZduK0_ccKID6Y0wuvi_VfqKQ",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.11.tar.zst",
      ],
      enable-preset true,
    },
  },
}
