{
  target {
    unpack-adt {
      main "unpack-adt.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    unpack-adt-wasm {
      main "unpack-adt.nt",
      platform "wasm32",
      execute ["wasmtime", "{{executable}}"],
    },
  },
  dependency {
    core {
      digest "WrKV7AqRarkVuQSLx9PlisMurRDCPO_sO9UxQ2u9RWY",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.3.tar.zst",
      ],
      enable-preset true,
    },
  },
}
