{
  target {
    multi-targets {
      main "multi-targets.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    multi-targets-wasm {
      main "multi-targets.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
    other-target {
      main "main.nt",
    },
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
  },
}
