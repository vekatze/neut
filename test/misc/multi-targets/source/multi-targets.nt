import {
  core::debug {assert},
}

define arch-tag() -> int {
  introspect target-arch {
  | amd64 =>
    1
  | arm64 =>
    2
  | wasm32 =>
    3
  }
}

define os-tag() -> int {
  introspect target-os {
  | linux =>
    10
  | default =>
    20
  }
}

define widen(x: introspect target-arch { | wasm32 => int32 | default => int64 }) -> int {
  introspect target-arch {
  | wasm32 =>
    sext-int32-int64(x)
  | default =>
    x
  }
}

define check-introspect() -> unit {
  let a = arch-tag();
  assert("arch is known", if le-int(1, a) { le-int(a, 3) } else { False });
  let o = os-tag();
  assert("os is known", if eq-int(o, 10) { True } else { eq-int(o, 20) });
  assert("introspect in a type", eq-int(widen(7), 7))
}

define main() -> unit {
  check-introspect();
  print("Hello, world!\n")
}
