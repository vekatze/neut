{
  target {
    static-file {
      main "static-file.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    static-file-wasm {
      main "static-file.nt",
      platform "wasm32",
      execute "wasmtime --dir=. {{executable}}",
    },
  },
  static-file {
    some-file "expected",
  },
  dependency {
    core {
      digest "XfFV2TbkGgQbBv9N7WgZbP4J9QIE8NO9e2o9YhtmyVA",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.8.tar.zst",
      ],
      enable-preset true,
    },
  },
}
