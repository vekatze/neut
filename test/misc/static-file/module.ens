{
  target {
    static-file {
      main "static-file.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    static-file-wasm {
      main "static-file.nt",
      platform "wasm32",
      execute "wasmtime --dir=. {{executable}}",
    },
  },
  static-file {
    some-file "expected",
  },
  dependency {
    core {
      digest "-hD_dy56xnr7w2oe-S8ZduK0_ccKID6Y0wuvi_VfqKQ",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.11.tar.zst",
      ],
      enable-preset true,
    },
  },
}
