{
  target {
    static-file {
      main "static-file.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    static-file-wasm {
      main "static-file.nt",
      platform "wasm32",
      execute ["wasmtime", "--dir=.", "{{executable}}"],
    },
  },
  static-file {
    some-file "expected",
  },
  dependency {
    core {
      digest "WrKV7AqRarkVuQSLx9PlisMurRDCPO_sO9UxQ2u9RWY",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.3.tar.zst",
      ],
      enable-preset true,
    },
  },
}
