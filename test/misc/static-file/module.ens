{
  target {
    static-file {
      main "static-file.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    static-file-wasm {
      main "static-file.nt",
      platform "wasm32",
      execute ["wasmtime", "--dir=.", "{{executable}}"],
    },
  },
  static-file {
    some-file "expected",
  },
  dependency {
    core {
      digest "hkhl9Bpp4lGL1MSTnhFmCGYbL9gG5Gg41VZ5LSNcd_o",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.6.tar.zst",
      ],
      enable-preset true,
    },
  },
}
