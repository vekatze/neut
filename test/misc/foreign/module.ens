{
  target {
    foreign {
      main "foreign.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    foreign-wasm {
      main "foreign.nt",
      platform "wasm32",
      execute "wasmtime {{executable}}",
    },
  },
  foreign {
    input [
      "foreign/add_const.c",
      "foreign/add_const_other.c",
    ],
    output [
      "object/",
      "add_const_other.o",
    ],
    link [
      "object/add_const.o",
    ],
    transitive-link-option [
      "$(printf '%s' -lm)",
    ],
    script [
      "mkdir -p {{foreign}}/object",
      "{{clang}} -c -flto=thin -O2 foreign/add_const.c -o {{foreign}}/object/add_const.o",
      "{{clang}} -c -flto=thin -O2 foreign/add_const_other.c -o {{foreign}}/add_const_other.o",
    ],
  },
  dependency {
    core {
      digest "fBLjigwWrBHLIDfDuIp73l0xLEnF9gCrf-cVnf0VOZU",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.10.tar.zst",
      ],
      enable-preset true,
    },
  },
}
