{
  target {
    foreign {
      main "foreign.nt",
      build-option [
        "-fsanitize=address",
      ],
    },
    foreign-wasm {
      main "foreign.nt",
      platform "wasm32",
      execute ["wasmtime", "{{executable}}"],
    },
  },
  foreign {
    input [
      "foreign/add_const.c",
    ],
    output [
      "add_const.o",
    ],
    script [
      "{{clang}} -c -flto=thin -O2 foreign/add_const.c -o {{foreign}}/add_const.o",
    ],
  },
  dependency {
    core {
      digest "dkLEcArAGd4jGy0MWYTmr4epu5hDMOdUJu6bsZoxiTg",
      mirror [
        "https://github.com/vekatze/neut-core/raw/main/archive/0.57.2.tar.zst",
      ],
      enable-preset true,
    },
  },
}
